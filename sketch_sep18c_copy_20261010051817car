#include <Servo.h>

const int frontIrLedPin = 6;
const int frontReceiverPin = 7;
const int leftIrLedPin = 10;
const int leftReceiverPin = 11;
const int rightIrLedPin = 2;
const int rightReceiverPin = 3;

const int leftServoPin = 13;
const int rightServoPin = 12;

const int leftStop = 1500;
const int rightStop = 1500;

const int forwardLeftSpeed = 30;
const int forwardRightSpeed = 35;
const int turnSpeed = 50;

const int forward5cmTime = 1000;
const int left90Time = 900;
const int right90Time = 900;
const int turn180Time = 1800;
const int smallLeftTime = 300;
const int smallRightTime = 300;

const int closeMaximum = 1;
const int openMinimum = 5;

Servo leftWheel;
Servo rightWheel;

bool returningToStart = false;
bool finished = false;

void stopRobot()
{
  leftWheel.writeMicroseconds(leftStop);
  rightWheel.writeMicroseconds(rightStop);
}

void driveForward(int leftSpeed, int rightSpeed)
{
  leftWheel.writeMicroseconds(leftStop + leftSpeed);
  rightWheel.writeMicroseconds(rightStop - rightSpeed);
}

void moveForward(int duration)
{
  driveForward(forwardLeftSpeed, forwardRightSpeed);
  delay(duration);
  stopRobot();
  delay(200);
}

void moveBackward(int duration)
{
  leftWheel.writeMicroseconds(leftStop - forwardLeftSpeed);
  rightWheel.writeMicroseconds(rightStop + forwardRightSpeed);
  delay(duration);
  stopRobot();
  delay(200);
}

void turnLeft(int duration)
{
  leftWheel.writeMicroseconds(leftStop - turnSpeed);
  rightWheel.writeMicroseconds(rightStop - turnSpeed);
  delay(duration);
  stopRobot();
  delay(200);
}

void turnRight(int duration)
{
  leftWheel.writeMicroseconds(leftStop + turnSpeed);
  rightWheel.writeMicroseconds(rightStop + turnSpeed);
  delay(duration);
  stopRobot();
  delay(200);
}

int irDetect(int irLedPin, int receiverPin, long frequency)
{
  tone(irLedPin, frequency);
  delay(1);

  int result = digitalRead(receiverPin);

  noTone(irLedPin);
  delay(1);

  return result;
}

int irDistance(int irLedPin, int receiverPin)
{
  int result = 0;

  for (long frequency = 38000; frequency <= 45000; frequency += 1000)
  {
    result += irDetect(irLedPin, receiverPin, frequency);
  }

  return result;
}

int averageDistance(int irLedPin, int receiverPin)
{
  int total = 0;

  for (int i = 0; i < 3; i++)
  {
    total += irDistance(irLedPin, receiverPin);
    delay(10);
  }

  return total / 3;
}

void readSensors(int &leftValue, int &frontValue, int &rightValue)
{
  leftValue = averageDistance(leftIrLedPin, leftReceiverPin);
  frontValue = averageDistance(frontIrLedPin, frontReceiverPin);
  rightValue = averageDistance(rightIrLedPin, rightReceiverPin);

  Serial.print("LEFT=");
  Serial.print(leftValue);
  Serial.print(" FRONT=");
  Serial.print(frontValue);
  Serial.print(" RIGHT=");
  Serial.println(rightValue);
}

void correctStartingPosition()
{
  int leftValue;
  int frontValue;
  int rightValue;

  readSensors(leftValue, frontValue, rightValue);

  bool frontOpen = frontValue >= openMinimum;
  bool leftClose = leftValue <= closeMaximum;
  bool rightClose = rightValue <= closeMaximum;
  bool leftOpen = leftValue >= openMinimum;
  bool rightOpen = rightValue >= openMinimum;

  if (!frontOpen)
  {
    return;
  }

  if (leftClose && rightValue >= 2 && rightValue < openMinimum)
  {
    turnRight(smallRightTime);
    moveForward(forward5cmTime);
    turnLeft(smallLeftTime);
    moveBackward(forward5cmTime);
  }
  else if (rightClose && leftValue >= 2 && leftValue < openMinimum)
  {
    turnLeft(smallLeftTime);
    moveForward(forward5cmTime);
    turnRight(smallRightTime);
    moveBackward(forward5cmTime);
  }
  else if (leftClose && rightOpen)
  {
    turnRight(smallRightTime);
  }
  else if (leftOpen && rightClose)
  {
    turnLeft(smallLeftTime);
  }
}

void followCorridor(int leftValue, int rightValue)
{
  int difference = leftValue - rightValue;

  if (difference <= -2)
  {
    driveForward(38, 18);
  }
  else if (difference >= 2)
  {
    driveForward(18, 38);
  }
  else
  {
    driveForward(forwardLeftSpeed, forwardRightSpeed);
  }
}

void performCorner(int leftValue, int rightValue)
{
  if (rightValue > leftValue)
  {
    turnRight(right90Time);
    moveForward(forward5cmTime);
  }
  else if (leftValue > rightValue)
  {
    turnLeft(left90Time);
    moveForward(forward5cmTime);
  }
  else if (rightValue > closeMaximum)
  {
    turnRight(right90Time);
    moveForward(forward5cmTime);
  }
  else
  {
    stopRobot();
    finished = true;
  }
}

void handleFrontWall()
{
  stopRobot();
  delay(200);

  int leftValue;
  int frontValue;
  int rightValue;

  readSensors(leftValue, frontValue, rightValue);

  if (frontValue > closeMaximum)
  {
    return;
  }

  bool deadEnd =
    leftValue <= closeMaximum &&
    rightValue <= closeMaximum;

  if (deadEnd)
  {
    if (!returningToStart)
    {
      turnRight(turn180Time);
      moveForward(forward5cmTime);
      returningToStart = true;
    }
    else
    {
      stopRobot();
      finished = true;
    }

    return;
  }

  performCorner(leftValue, rightValue);
}

void setup()
{
  Serial.begin(9600);

  pinMode(frontIrLedPin, OUTPUT);
  pinMode(leftIrLedPin, OUTPUT);
  pinMode(rightIrLedPin, OUTPUT);

  pinMode(frontReceiverPin, INPUT);
  pinMode(leftReceiverPin, INPUT);
  pinMode(rightReceiverPin, INPUT);

  leftWheel.attach(leftServoPin);
  rightWheel.attach(rightServoPin);

  stopRobot();

  correctStartingPosition();
}

void loop()
{
  if (finished)
  {
    stopRobot();
    return;
  }

  int leftValue;
  int frontValue;
  int rightValue;

  readSensors(leftValue, frontValue, rightValue);

  if (frontValue <= closeMaximum)
  {
    handleFrontWall();
  }
  else
  {
    followCorridor(leftValue, rightValue);
  }

  delay(30);
}
